[Unit]
Description=wisp meeting assistant daemon
After=pipewire-pulse.service

[Service]
ExecStart=@REPO@/daemon/.venv/bin/wispd serve
Restart=on-failure
RestartSec=2
# `claude` lives in ~/.local/bin, which systemd's PATH lacks.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Environment=PYTHONUNBUFFERED=1
# Below normal CPU priority, so speech decoding never makes the call stutter.
Nice=5

# No [Install] section on purpose: wisp never starts at login. The `wisp`
# command starts this unit when you ask for it.
